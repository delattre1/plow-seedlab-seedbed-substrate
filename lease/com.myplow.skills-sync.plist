<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily: pack the owner's ~/.claude/skills for their cloud MyPlow (lease/sync-skills.py). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.myplow.skills-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/delattre/workspace/plow-seedlab-seedbed-substrate/lease/sync-skills.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>17</integer></dict>
  <key>StandardOutPath</key><string>/Users/delattre/Library/Logs/myplow-skills-sync.log</string>
  <key>StandardErrorPath</key><string>/Users/delattre/Library/Logs/myplow-skills-sync.log</string>
</dict>
</plist>
