# ============================================================================
# config.env.example — copy to a GITIGNORED file (e.g. config.env) and fill in.
# NEVER commit real values. The public repo stays secret-free; secrets live in
# your shell / a gitignored env file / a CI secret store and are referenced here
# by name only.
# ============================================================================

# --- Docker host (where containers run). Empty = local daemon. ---
# The substrate docker host in this setup is the Linux `server`:
# export DOCKER_HOST=ssh://server

# --- Golden image (pre-hydrated seed snapshot) ---
# export GOLDEN_IMAGE=seedbed-golden:latest

# --- Docker Hub publish (gate 4) — ASK CEO for repo + create an access token ---
# export DOCKERHUB_REPO=<org>/<repo>      # e.g. plowco/seedbed-substrate   <-- ASK CEO
# export DOCKERHUB_USER=<dockerhub-username>
# export DOCKERHUB_TOKEN=<dockerhub-access-token>   # revocable token, NOT a password

# --- Seed hydration secrets (read at BUILD time only; NEVER baked into image) ---
# These already live in the host's gitignored files; build-golden.sh reads them:
#   QUEUE_SECRET        ~/.config/mypeople/queue.env
#   TAILSCALE_API_KEY   ~/workspace/seedlab/.env
#   TKMX_API_KEY        ~/workspace/seedlab/.env
#   TKMX_USERNAME       ~/workspace/seedlab/.env
# export HYDRATE_DRIVER=$HOME/build-seedbed-node.sh   # the seed-hydration script
